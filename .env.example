# VLESS + REALITY Setup Variables
# Used by single-host/setup-reality.sh
# Copy and export these before running the script, or pass them inline:
#   sudo SERVER_HOST=203.0.113.1 ./single-host/setup-reality.sh

# === Required ===

# Your VPS public IP or domain name.
# If left empty the script auto-detects via api.ipify.org.
SERVER_HOST=<YOUR_SERVER_IP>

# === Optional overrides (script has sensible defaults) ===

# REALITY camouflage target — a legitimate TLS 1.3 site.
# Default: www.bing.com:443
TARGET=www.bing.com:443

# SNI / Server Name presented to clients.
# Default: www.bing.com
SERVER_NAME=www.bing.com

# Listening port for the VLESS inbound.
# Default: 443
PORT=443

# Pre-set UUID instead of letting the script generate one.
# Leave empty to auto-generate.
UUID=

# Pre-set Short ID (8-byte hex) instead of auto-generating.
# Leave empty to auto-generate.
SHORT_ID=

# Set to 1 to disable Zeabur-managed k3s/containerd on first boot.
# Set to 0 if your VPS is not a Zeabur Dedicated Server.
# Default: 1
DISABLE_ZEABUR_K3S=1
